# Copy to .env and fill in. Never commit .env.
# .env holds secrets, connection strings, and overrides only. Blank values fall back to
# defaults (ports and bucket names in docker-compose.yml; other settings in api config.py, from DESIGN.md).

# --- Local host ports (docker-compose) ---
POSTGRES_PORT=
REDIS_PORT=
KEYCLOAK_PORT=
MINIO_API_PORT=
MAILPIT_SMTP_PORT=
MAILPIT_UI_PORT=

# --- Postgres ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# --- Redis ---
REDIS_URL=

# --- Keycloak (OIDC) ---
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# --- Object storage (MinIO locally, Linode Object Storage in prod) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PDFS=
S3_BUCKET_MARKDOWN=
S3_BUCKET_BACKUPS=

# --- AI providers ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Bake-off only
OPENAI_API_KEY=
COHERE_API_KEY=

# --- Model and pipeline config (bake-off switches) ---
PDF_CONVERTER=
EMBEDDING_MODEL=
RERANKER_MODEL=
RERANKER_FALLBACK_MODEL=
LLM_MODEL=
LLM_MODEL_STRONG=
CHUNKING_STRATEGY=
CHUNK_SIZE_TOKENS=
CHUNK_OVERLAP_TOKENS=
FULL_CONTEXT_MAX_TOKENS=
ABSTAIN_THRESHOLD=

# --- Budget and limits ---
AI_MONTHLY_BUDGET_USD=
DAILY_LIMIT_MIN=
DAILY_LIMIT_MAX=
BURST_LIMIT_PER_MINUTE=

# --- Kill switches ---
MAINTENANCE_MODE=
PAUSE_AI=
DISABLE_SIGNUPS=

# --- Privacy ---
CONSENT_POLICY_VERSION=
RETENTION_MONTHS=
ACCOUNT_DELETION_GRACE_DAYS=

# --- Email (Resend SMTP in prod, Mailpit locally) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Observability ---
SENTRY_DSN_API=
NEXT_PUBLIC_SENTRY_DSN_WEB=
ALERT_WEBHOOK_URL=

# --- Web ---
NEXT_PUBLIC_API_URL=

# --- Infra (Terraform) ---
LINODE_TOKEN=
